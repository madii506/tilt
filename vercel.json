{
  "cleanUrls": true,
  "functions": { "api/pairs.js": { "maxDuration": 15 }, "api/bags.js": { "maxDuration": 20 } },
  "headers": [
    { "source": "/assets/(js|css)/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/assets/(fonts|img)/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=86400" }] }
  ]
}
